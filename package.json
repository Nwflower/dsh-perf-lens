{
  "name": "dsh-perf-lens",
  "version": "0.1.0",
  "description": "Resource-overhead lens for DeepSeek Harness plugins: which plugin is burning CPU, memory and disk, attributed inside the single host process. | DeepSeek Harness 插件资源开销分析面板：回答哪个插件在吃 CPU、内存与磁盘。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-alpha.1": "compatible"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "plugin",
    "performance",
    "profiler",
    "cpu",
    "memory",
    "inspector"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.0",
    "oxlint": "^1.85.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
