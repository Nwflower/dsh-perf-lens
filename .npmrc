# The harness client packages must be pinned to the installed DSH baseline: the
# registry's `latest` tag points at 0.0.1-rc.1, which depends on packages that no
# longer exist (@deepseek-ai/dsh-compact 404s). Never let pnpm auto-install the
# full peer graph here; the peerDependencies in package.json stay advisory.
auto-install-peers=false
# Build scripts of transitive tooling are irrelevant to a plugin that ships no
# native code; ignore them instead of failing the install.
strict-dep-builds=false
